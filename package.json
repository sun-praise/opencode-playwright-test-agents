{
  "name": "opencode-playwright-test-agents",
  "version": "0.1.0",
  "description": "OpenCode plugin providing Playwright MCP test agents (verify & generate)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --outdir=dist --bundle --platform=node --format=esm --target=node18",
    "dev": "esbuild src/index.ts --outdir=dist --bundle --platform=node --format=esm --target=node18 --watch"
  },
  "keywords": [
    "opencode",
    "playwright",
    "mcp",
    "testing",
    "e2e",
    "agents"
  ],
  "author": "svtter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/svtter/opencode-playwright-test-agents.git"
  },
  "files": [
    "dist",
    "src/templates"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  }
}
